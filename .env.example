# RevenueCat public SDK keys (Project settings > API keys in the RevenueCat dashboard).
# Copy to .env.local and fill in. Without a key for where the app runs, Pro says it isn't on sale yet.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
# Test Store key (test_...), used in Expo Go and the web build, which can't reach the real stores.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_xxx
